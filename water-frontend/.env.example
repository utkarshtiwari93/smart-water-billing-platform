# Same Web client ID you use for GOOGLE_CLIENT_ID in the backend.
# When empty, the Google button stays visible and explains that setup is required.
VITE_GOOGLE_CLIENT_ID=

# Keep AquaBot hidden until a real backend answer provider is configured.
VITE_AQUABOT_ENABLED=false

# Only needed when the frontend is NOT served through the Vite dev proxy
# (for example a production build hosted on another domain).
# VITE_API_BASE=http://localhost:8080
